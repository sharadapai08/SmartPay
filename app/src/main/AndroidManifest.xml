<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".SmartPayApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPay">

        <!-- Splash – sole launcher activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartPay.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- Add Money flow -->
        <activity
            android:name=".AddMoneyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".UpiBankActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".CardPaymentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Send Money flow -->
        <activity
            android:name=".SendMoneyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ConfirmSendActivity"
            android:exported="false" />

        <activity
            android:name=".MoneysentActivity"
            android:exported="false" />

        <activity
            android:name=".SendSuccessActivity"
            android:exported="false" />

        <!-- Receive Money -->
        <activity
            android:name=".ReceiveMoneyActivity"
            android:exported="false" />

        <!-- QR Scanner -->
        <activity
            android:name=".QrScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- QR Pay -->
        <activity
            android:name=".QrPayActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Transactions -->
        <activity
            android:name=".TransactionsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Edit Profile -->
        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Bank Account -->
        <activity
            android:name=".AddBankAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notifications -->
        <activity
            android:name=".NotificationsActivity"
            android:exported="true" />


        <!-- FileProvider for sharing QR code images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>